# ── Core (all required) ─────────────────────────────────────────────
# Postgres connection string. Pterodactyl: use the host/port of your Postgres server.
DATABASE_URL=postgresql://tunebridge:CHANGE_ME@postgres:5432/tunebridge
# The PUBLIC https URL users reach (OAuth redirect URIs are built from it).
APP_URL=https://tunebridge.jac-sys.net
# Encrypts provider tokens at rest (AES-256-GCM). Generate:  openssl rand -base64 32
# Format "<version>:<base64 key>[,<version>:<key>…]"; ACTIVE picks the key used for new writes.
TOKEN_ENC_KEYS=1:REPLACE_WITH_BASE64_32_BYTES
TOKEN_ENC_ACTIVE=1

# ── Sign in with Google ─────────────────────────────────────────────
# Google Cloud Console → Credentials → OAuth client (Web). Authorized redirect URI:
#   ${APP_URL}/api/auth/google/callback
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
# Who may create an account: allowlist (default) | open | closed. The first person to sign in becomes admin.
AUTH_SIGNUP=allowlist
ALLOWED_EMAILS=you@gmail.com
ALLOWED_EMAIL_DOMAINS=
# Optional built-in admin login (works without any identity provider). Password must be 12+ chars.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional generic OIDC (Authentik / Authelia / Keycloak). Redirect URI: ${APP_URL}/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=SSO

# ── Spotify (bring your own developer app) ──────────────────────────
# Redirect URI: ${APP_URL}/api/connect/spotify/callback   (must be https, or http://127.0.0.1)
# NOTE: since Feb 2026 a Spotify app in Development Mode needs a Premium owner and allows max 5 users.
SPOTIFY_CLIENT_ID=

# ── Tuning (optional) ───────────────────────────────────────────────
APP_ROLE=all              # web | worker | all
WORKER_CONCURRENCY=4
DB_POOL_MAX=10
RUN_MIGRATIONS=true
